# ============================================================
# Secrets — NEVER commit
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Python
# ============================================================
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Project artifacts (regenerable, don't ship)
# ============================================================
# LoRA training checkpoints (large)
outputs/

# Converted GAPs PNGs (regenerated by script 01)
data/images/

# Training/valid/test JSONs (regenerated by script 02)
data/*.json

# Manifest CSVs (regenerated by script 01)
data/*.csv

# In-flight eval checkpoints (and their .bak fallback files)
eval_results/.stage*_checkpoint*.json
eval_results/.stage*_checkpoint*.json.bak
eval_results/.stage*_checkpoint*.tmp

# One-off debug downloads
fail_inspect.jpg

# 60+MB binary, downloaded separately
cloudflared.exe

# Third-party source clone — installed in editable mode, not our code
LLaMA-Factory-src/

# Training run artifacts (regenerated each run)
outputs/training_run.json
outputs/training_run_history.jsonl
outputs/stdout.log
outputs/stderr.log
preflight_problems.txt

# ============================================================
# Promoted adapter weights (large; regenerable; commit metadata.json + config only)
# ============================================================
# The actual LoRA weights are too big for GitHub (>100MB). The adapter dir is
# regenerable by re-running training. We commit the small files (metadata.json,
# adapter_config.json, README.md) so the paper-trail of what was deployed
# survives in the repo, but exclude the binary weights and tokenizer dumps.
adapters/**/*.safetensors
adapters/**/optimizer.pt
adapters/**/scheduler.pt
adapters/**/rng_state.pth
adapters/**/training_args.bin
adapters/**/tokenizer.json
adapters/**/vocab.json
adapters/**/merges.txt

# ============================================================
# Raw datasets (multi-GB, downloaded separately)
# ============================================================
GAPs v2/
RDD/
Attain/
test_fixtures/*.jpg
test_fixtures/*.jpeg
test_fixtures/*.png

# ============================================================
# Generated paper artifacts (re-runnable via the handbook script)
# ============================================================
paper/diagrams/

# ============================================================
# Generated PDFs (large; re-runnable via scripts/generate_handbook_pdf.py)
# ============================================================
paper/*.pdf

# ============================================================
# Tunneling (machine-specific, downloaded separately)
# ============================================================
tunnel/
*.exe

# ============================================================
# Claude Code session metadata (machine-specific)
# ============================================================
.claude/

# ============================================================
# IDE / OS
# ============================================================
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# ============================================================
# Build / cache
# ============================================================
*.log
*.tmp
node_modules/
dist/
build/
