# ============================================================
# Secrets — NEVER commit
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Python
# ============================================================
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Project artifacts (regenerable, don't ship)
# ============================================================
# LoRA training checkpoints (large)
outputs/

# Converted GAPs PNGs (regenerated by script 01)
data/images/

# Training/valid/test JSONs (regenerated by script 02)
data/*.json

# Manifest CSVs (regenerated by script 01)
data/*.csv

# In-flight eval checkpoints
eval_results/.stage*_checkpoint*.json

# One-off debug downloads
fail_inspect.jpg

# 60+MB binary, downloaded separately
cloudflared.exe

# ============================================================
# Raw datasets (multi-GB, downloaded separately)
# ============================================================
GAPs v2/
RDD/
Attain/
test_fixtures/*.jpg
test_fixtures/*.jpeg
test_fixtures/*.png

# ============================================================
# Generated paper artifacts (re-runnable via the handbook script)
# ============================================================
paper/diagrams/

# ============================================================
# Generated PDFs (large; re-runnable via scripts/generate_handbook_pdf.py)
# ============================================================
paper/*.pdf

# ============================================================
# Tunneling (machine-specific, downloaded separately)
# ============================================================
tunnel/
*.exe

# ============================================================
# Claude Code session metadata (machine-specific)
# ============================================================
.claude/

# ============================================================
# IDE / OS
# ============================================================
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# ============================================================
# Build / cache
# ============================================================
*.log
*.tmp
node_modules/
dist/
build/
