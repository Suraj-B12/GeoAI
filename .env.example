# GeoAI / Pavement Distress Pipeline — environment variables template
# Copy this file to .env and fill in the SUPABASE_SERVICE_KEY value.
#
# .env is gitignored (contains secrets). .env.example is committed
# (no secrets, documents the expected variables).

# ============================================================
# Required — Supabase operator pipeline
# ============================================================
SUPABASE_URL=https://vtlkitpoffudiefuoijb.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_YOUR_KEY_HERE

# ============================================================
# Production model selection — Improved Baseline pipeline
# ============================================================
# We run the BASE Qwen2.5-VL-7B-Instruct with IRC:82-aligned v2 prompts
# (deep persona + stakes + 6-step IRC:82-2015 inspection protocol +
# quantitative severity criteria).
#
# Empirically verified to beat the RDD-fine-tuned adapter on:
#   - multi-class detection rate     (52.5% vs 16.9% on Attain WS_V2.0)
#   - zero-shot classes               (Block crack F1 0.30 vs 0.00)
#   - cross-geography Pothole recall  (F1 0.27 vs 0.00 on NZ wide-angle)
# See eval_results/attain_3way_comparison.md for the full study.
#
# IRC:82-2015 compliance: 100% on 100-image audit (zero hallucinations).
# See eval_results/irc82_verification_report.md.
DISABLE_ADAPTER=true
PROMPTS_VERSION=v2

# ============================================================
# Legacy / experimental — DO NOT enable in production
# ============================================================
# Path to the RDD-fine-tuned LoRA adapter from Phase 2c. Kept for paper
# A/B experiments only. To revert to the adapter pathway:
#   1. Set DISABLE_ADAPTER=false (or remove that line)
#   2. Uncomment the ADAPTER_PATH line below
# ADAPTER_PATH=adapters/v2-rdd-2epochs-20260507

# ============================================================
# Optional — performance + hardware
# ============================================================

# Force fp16 (no quantization) — only on A5000 with 24GB+ VRAM.
# Default is 4 (bitsandbytes 4-bit, fits 6GB+).
QUANTIZATION_BITS=0

# Lower this if you hit GPU OOM on very large phone photos.
# Default is 2200*2200 = 4840000.
# MAX_IMAGE_PIXELS=3686400

# ============================================================
# Optional — security
# ============================================================
# Comma-separated API keys for /classify endpoint auth.
# Empty/unset = auth disabled (development only — set keys in production).
# API_KEYS=key1,key2

# Allowed CORS origins. Default = "*" (any origin).
# CORS_ORIGINS=https://your-frontend.com,https://admin.your-frontend.com

# ============================================================
# Cloudinary — image hosting + hard-delete from dashboard
# ============================================================
# Without these, dashboard /dashboard/delete still removes the Supabase row
# but the image lives on as orphan in Cloudinary. Set all three to enable
# automated Cloudinary deletion when operator clicks the dashboard delete
# button (with confirmation modal).
# CLOUDINARY_CLOUD_NAME=your-cloud
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your-api-secret

# ============================================================
# Optional — worker tunables
# ============================================================
# WORKER_POLL_INTERVAL=10
# WORKER_BATCH_SIZE=5
# WORKER_MAX_RETRIES=3

# ============================================================
# Optional — test fixtures
# ============================================================
# Mount /test_fixtures/* static route for the robustness test suite.
# Leave commented for production.
# ENABLE_TEST_FIXTURES=1
